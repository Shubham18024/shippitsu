<%- include('partials/head') %>
<body>
    <%- include('partials/navbar') %>

    <header class="hero">
        <div class="wrap">
            <div class="kanji">執筆</div>
            <h1>Shippitsu</h1>
            <p class="sub">shippitsu (執筆) — Japanese for "writing," as in authoring something for publication. A quiet corner on the internet for writing that matters to you.</p>
            <p class="meta">Built with Express, EJS, and vanilla JavaScript</p>
        </div>
    </header>

    <!-- The Feed  -->
    <section id="recent-posts">
        <div class="wrap">
            <p class="eyebrow">Recent Writing</p>
            
            <div class="grid2" id="post-grid">
                <!-- Posts will be dynamically injected here via JavaScript -->
            </div>
        </div>
    </section>

    <script src="/js/markdown.js"></script>
    <script src="/js/main.js"></script>

    <div id="delete-modal" class="modal-overlay" aria-hidden="true">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
            <h3 id="delete-modal-title" style="font-family: var(--serif); font-size: 24px; margin-bottom: 12px; color: var(--espresso);">Delete Post?</h3>
            <p id="delete-modal-message" style="color: var(--muted); font-size: 15px; margin-bottom: 24px; line-height: 1.6;">
                Are you sure you want to delete this post? This action cannot be undone.
            </p>
            <div class="modal-actions">
                <button type="button" class="modal-action modal-action-secondary" onclick="document.getElementById('delete-modal').style.display='none'">Cancel</button>
                <button type="button" class="modal-action modal-action-danger" id="delete-confirm-button">Yes, Delete</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>